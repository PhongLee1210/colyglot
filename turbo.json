{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "cacheMaxAge": "7d",
  "boundaries": {
    "tags": {
      "app": {
        "dependencies": {
          "allow": ["package"]
        }
      },
      "package": {
        "dependencies": {
          "deny": ["app"]
        }
      },
      "srs": {
        "dependencies": {
          "allow": ["tooling"]
        }
      }
    }
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"],
      "env": ["DATABASE_URL"]
    },
    "test:e2e": {
      "dependsOn": ["build", "test"],
      "cache": false,
      "env": ["DATABASE_URL", "E2E_SIGNIN_TOKEN"]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    }
  }
}
