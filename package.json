{
  "name": "colyglot",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "start": "turbo run start",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck",
    "boundaries": "turbo boundaries",
    "ci": "turbo run lint typecheck test test:e2e --continue && turbo boundaries",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "catalog": {
    "@types/bun": "^1.4.2",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "prettier-plugin-organize-imports": "^4.3.0",
    "turbo": "^2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": "prettier --write"
  },
  "packageManager": "bun@1.3.7"
}
